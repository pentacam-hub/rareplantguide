{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rareplant-content-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "triggers": {
    "crons": [
      "30 14 * * *",
      "30 19 * * SUN,TUE,WED,FRI,SAT",
      "30 19 * * MON,THU"
    ]
  },
  "observability": {
    "enabled": true
  }
}
